// Kelime Defteri — Prisma schema
// Default datasource is SQLite (zero-config, file-based, perfect for a
// single-user notebook app or local-first deployment). Swapping to
// Postgres/Supabase later only requires changing `provider` + `url` here.
//
// Note: SQLite has no native enum type, so fields that are conceptually
// enums (PartOfSpeech, CardStatus, ReviewRating, HighlightStyle) are
// stored as validated String columns instead — the enum-like union types
// live in src/types/index.ts and are enforced at the API boundary with
// zod (see src/lib/validation.ts). Switching to Postgres later can
// reintroduce real `enum` blocks if desired.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Card {
  id             String   @id @default(cuid())
  vocabulary     String
  ipa            String?
  audioUrl       String?
  definitionEn   String?
  definitionTr   String?
  partOfSpeech   String? // NOUN | VERB | ADJECTIVE | ADVERB | PREPOSITION | CONJUNCTION | PRONOUN | INTERJECTION
  mnemonic       String?
  collocations   String?
  notes          String?

  // SRS (SM-2) state
  status         String   @default("NEW") // NEW | LEARNING | REVIEW | MASTERED
  easeFactor     Float    @default(2.5)
  intervalDays   Float    @default(0)
  repetitions    Int      @default(0)
  dueAt          DateTime @default(now())
  lastReviewedAt DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  examples       ExampleSentence[]
  tags           TagsOnCards[]
  reviews        ReviewLog[]

  @@index([dueAt])
  @@index([vocabulary])
}

model ExampleSentence {
  id            String   @id @default(cuid())
  cardId        String
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text          String
  // Character offsets of the target word occurrence(s) inside `text`,
  // stored as JSON e.g. "[[4,9]]", so highlighting survives arbitrary
  // inflections ("runs", "running") without re-matching at render time.
  highlightSpans String  @default("[]")
  order         Int      @default(0)
  source        String   @default("USER") // USER | AI

  @@index([cardId])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String        @default("accent")
  createdAt DateTime      @default(now())
  cards     TagsOnCards[]
}

model TagsOnCards {
  cardId String
  tagId  String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
}

model ReviewLog {
  id             String   @id @default(cuid())
  cardId         String
  card           Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating         String // AGAIN | HARD | GOOD | EASY
  intervalBefore Float
  intervalAfter  Float
  easeBefore     Float
  easeAfter      Float
  reviewedAt     DateTime @default(now())

  @@index([cardId])
  @@index([reviewedAt])
}

// Singleton row (id always "singleton") holding user preferences and
// streak/progress counters. Modeled as a table (not a JSON file) so it
// persists the same way everything else does and is trivial to extend to
// multi-user later by adding a userId column.
model Settings {
  id             String    @id @default("singleton")
  theme          String    @default("sakura")
  fontStyle      String    @default("sans")
  highlightStyle String    @default("BOLD_UNDERLINE") // BOLD | UNDERLINE | COLOR | BOLD_UNDERLINE
  ttsRate        Float     @default(0.95)
  dailyGoal      Int       @default(10)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastStudyDate  DateTime?
  totalReviews   Int       @default(0)
  updatedAt      DateTime  @updatedAt
}

// Cache of AI + dictionary-API responses so the same word/field is never
// paid for twice. Keyed by a deterministic hash of (kind, input).
model AICache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  kind      String
  response  String
  createdAt DateTime @default(now())

  @@index([kind])
}
