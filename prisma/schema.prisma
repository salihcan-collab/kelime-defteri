// Kelime Defteri — Prisma schema
// Postgres-backed (works with Render's free managed Postgres, Supabase,
// Neon, or any standard Postgres connection string in DATABASE_URL) so
// the app can run on a host with no persistent local disk.
//
// Note: fields that are conceptually enums (PartOfSpeech, CardStatus,
// ReviewRating, HighlightStyle) are still stored as validated String
// columns rather than native Postgres enums — that's a holdover from an
// earlier SQLite-backed version of this schema (SQLite has no enum type)
// kept for simplicity, since the enum-like union types already live in
// src/types/index.ts and are enforced at the API boundary with zod (see
// src/lib/validation.ts). Feel free to convert them to real `enum` blocks
// later; it's a compatible change either way.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Deliberately minimal accounts model — see src/lib/auth.ts. Signup is
// capped at MAX_USERS (2) at the application layer so this stays a small
// shared notebook for you and one other person, not an open app.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  cards     Card[]
  tags      Tag[]
  reviews   ReviewLog[]
  settings  Settings?
}

model Card {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     String
  ipa            String?
  audioUrl       String?
  definitionEn   String?
  definitionTr   String?
  partOfSpeech   String? // NOUN | VERB | ADJECTIVE | ADVERB | PREPOSITION | CONJUNCTION | PRONOUN | INTERJECTION
  mnemonic       String?
  collocations   String?
  notes          String?

  // SRS (SM-2) state
  status         String   @default("NEW") // NEW | LEARNING | REVIEW | MASTERED
  easeFactor     Float    @default(2.5)
  intervalDays   Float    @default(0)
  repetitions    Int      @default(0)
  dueAt          DateTime @default(now())
  lastReviewedAt DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  examples       ExampleSentence[]
  tags           TagsOnCards[]
  reviews        ReviewLog[]

  @@index([userId, dueAt])
  @@index([userId, vocabulary])
}

model ExampleSentence {
  id            String   @id @default(cuid())
  cardId        String
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text          String
  // Character offsets of the target word occurrence(s) inside `text`,
  // stored as JSON e.g. "[[4,9]]", so highlighting survives arbitrary
  // inflections ("runs", "running") without re-matching at render time.
  highlightSpans String  @default("[]")
  order         Int      @default(0)
  source        String   @default("USER") // USER | AI

  @@index([cardId])
}

// Tags are personal to each notebook (not shared between the two
// accounts), so uniqueness is scoped to (userId, name) rather than global.
model Tag {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String        @default("accent")
  createdAt DateTime      @default(now())
  cards     TagsOnCards[]

  @@unique([userId, name])
}

model TagsOnCards {
  cardId String
  tagId  String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
}

model ReviewLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId         String
  card           Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating         String // AGAIN | HARD | GOOD | EASY
  intervalBefore Float
  intervalAfter  Float
  easeBefore     Float
  easeAfter      Float
  reviewedAt     DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([cardId])
}

// One row per user, holding preferences and streak/progress counters.
model Settings {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme          String    @default("sakura")
  fontStyle      String    @default("sans")
  highlightStyle String    @default("BOLD_UNDERLINE") // BOLD | UNDERLINE | COLOR | BOLD_UNDERLINE
  ttsRate        Float     @default(0.95)
  dailyGoal      Int       @default(10)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastStudyDate  DateTime?
  totalReviews   Int       @default(0)
  updatedAt      DateTime  @updatedAt
}

// Cache of AI + dictionary-API responses so the same word/field is never
// paid for twice. Deliberately NOT scoped per-user — a word's definition
// or IPA is the same regardless of who asked, so both accounts benefit
// from a single shared cache entry. Keyed by a deterministic hash of
// (kind, input).
model AICache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  kind      String
  response  String
  createdAt DateTime @default(now())

  @@index([kind])
}
