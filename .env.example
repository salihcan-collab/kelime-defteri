# Copy this file to .env and fill in your own values.

# SQLite database file used by Prisma. Note: Prisma resolves a relative
# sqlite path against the *prisma/* directory (not the project root), so
# this creates prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Your OpenAI API key. Required for every AI-assisted feature (card
# auto-fill, memory hooks, IPA generation, AI quiz questions). All AI
# features degrade gracefully (buttons disable with a tooltip) if this is
# unset, so the app is still fully usable as a manual notebook without it.
OPENAI_API_KEY=""

# Model used for structured text generation (card fields, quizzes).
# The product spec asks for "gpt-5.6-luna". As of this app's release there
# is no publicly documented OpenAI model with that name — double check the
# exact string against https://platform.openai.com/docs/models for your
# account before deploying, and swap it here if it needs to change. Every
# call in src/lib/openai.ts reads this single env var, so updating the
# model never requires a code change.
OPENAI_MODEL="gpt-5.6-luna"

# Optional fallback model automatically retried if OPENAI_MODEL is rejected
# by the API (e.g. "model not found"), so AI features keep working while
# you sort out the right model name above.
OPENAI_FALLBACK_MODEL="gpt-4o-mini"
